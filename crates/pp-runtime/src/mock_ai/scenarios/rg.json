{
	"prompt": "Run the embedded local rg fixture.",
	"edit_mode": "replace",
	"files": {
		"rg/alpha.txt": "Alpha one\nneedle first\ncontext before\nneedle second\ncontext after\n",
		"rg/beta.txt": "beta Needle case\n",
		"rg/long.txt": "needle \n"
	},
	"lanes": {
		"root": [
			{
				"tool": {
					"name": "rg",
					"arguments": {
						"pattern": "needle",
						"path": "rg"
					}
				},
				"auto_continue": false
			},
			{
				"tool": {
					"name": "rg",
					"arguments": {
						"pattern": "NEEDLE",
						"path": "rg",
						"case": false
					}
				},
				"auto_continue": false
			},
			{
				"tool": {
					"name": "rg",
					"arguments": {
						"pattern": "zzz-absent-pattern",
						"path": "rg"
					}
				},
				"auto_continue": false
			},
			{
				"tool": {
					"name": "rg",
					"arguments": {
						"pattern": "needle",
						"path": "rg/missing"
					}
				},
				"auto_continue": false
			},
			{
				"content": "rg fixture complete.",
				"auto_continue": false
			}
		]
	}
}
