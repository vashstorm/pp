{
	"prompt": "Run the embedded local read fixture.",
	"edit_mode": "replace",
	"files": {
		"main.rs": "fn main() {\n    // 固定读取 main.rs：Unicode 注释\n    let fixture = \"read-fixture-line\";\n    println!(\"{fixture}\");\n    // fifth preview line\n    // sixth-tail-marker\n}\n"
	},
	"lanes": {
		"root": [
			{
				"tool": {
					"name": "read",
					"arguments": {
						"path": "main.rs"
					}
				},
				"auto_continue": false
			},
			{
				"tool": {
					"name": "read",
					"arguments": {
						"path": "main.rs:2-3"
					}
				},
				"auto_continue": false
			},
			{
				"tool": {
					"name": "read",
					"arguments": {
						"path": "main.rs:raw"
					}
				},
				"auto_continue": false
			},
			{
				"content": "Read fixture complete.",
				"auto_continue": false
			}
		]
	}
}
