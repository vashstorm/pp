{
	"prompt": "Run the embedded local grep fixture.",
	"edit_mode": "replace",
	"files": {
		"grep/alpha.txt": "Alpha one\nneedle first\ncontext before\nneedle second\ncontext after\n",
		"grep/beta.txt": "beta Needle case\n",
		"grep/long.txt": "needle \n"
	},
	"lanes": {
		"root": [
			{
				"tool": {
					"name": "grep",
					"arguments": {
						"pattern": "needle",
						"path": "grep"
					}
				},
				"auto_continue": false
			},
			{
				"tool": {
					"name": "grep",
					"arguments": {
						"pattern": "NEEDLE",
						"path": "grep",
						"case": false
					}
				},
				"auto_continue": false
			},
			{
				"tool": {
					"name": "grep",
					"arguments": {
						"pattern": "zzz-absent-pattern",
						"path": "grep"
					}
				},
				"auto_continue": false
			},
			{
				"tool": {
					"name": "grep",
					"arguments": {
						"pattern": "needle",
						"path": "grep/missing"
					}
				},
				"auto_continue": false
			},
			{
				"content": "Grep fixture complete.",
				"auto_continue": false
			}
		]
	}
}
